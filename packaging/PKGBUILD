# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=ooip-bin
_pkgname=ooip
pkgver=0.1.0
pkgrel=1
pkgdesc="Inspects and configures IP addresses, interfaces, and link layer states."
arch=('x86_64')
url="https://github.com/openOODA-tools/ooip"
license=('Apache-2.0')
depends=('glibc')
provides=('ooip')
conflicts=('ooip')
source_x86_64=("${url}/releases/download/v${pkgver}/ooip-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/ooip-linux-x86_64" "${pkgdir}/usr/bin/ooip"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/ooip-uninstall"
}
